# Cấu hình máy chủ
SC_PORT=8080

# Cấu hình CSDL SQL Server
SC_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SecureChatDB;encrypt=true;trustServerCertificate=true
SC_DB_USER=sa
SC_DB_PASSWORD=your_password_here

# Cấu hình Mail (Dev)
SC_MAIL_ENABLED=false
SC_MAIL_HOST=smtp.gmail.com
SC_MAIL_PORT=587
SC_MAIL_USER=your_email@gmail.com
SC_MAIL_PASSWORD=your_app_password

SC_IDENTITY_KEY_PATH=./server_identity.key